<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_bg" android:gravity="center_vertical">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#9AA0AA" android:textSize="12sp" android:text="@string/w_next"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_prayer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textColor="#FDDB00" android:textSize="20sp" android:textStyle="bold" android:text="@string/app_name"/>
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="20sp" android:text=""/>
    </LinearLayout>
    <TextView android:id="@+id/w_prog" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textColor="#D0D4DA" android:textSize="12sp" android:text=""/>
    <ProgressBar android:id="@+id/w_bar" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp"
        android:max="100" android:progress="0" android:progressTint="#FDDB00" android:progressBackgroundTint="#44FFFFFF"/>
    <TextView android:id="@+id/w_adh" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:background="@drawable/widget_btn" android:gravity="center"
        android:paddingTop="7dp" android:paddingBottom="7dp" android:textColor="#111111" android:textSize="13sp" android:textStyle="bold" android:text="@string/w_adh"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w2_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_bg" android:gravity="center">
    <TextView android:id="@+id/w2_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#9AA0AA" android:textSize="11sp" android:text="@string/w_next"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w2_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FDDB00" android:textSize="17sp" android:textStyle="bold" android:text="@string/app_name"/>
        <TextView android:id="@+id/w2_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#D0D4DA" android:textSize="13sp" android:text=""/>
    </LinearLayout>
    <Chronometer android:id="@+id/w2_cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
</LinearLayout>

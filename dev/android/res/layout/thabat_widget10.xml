<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w10_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w10_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#EB6834" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text=""/>
        <TextView android:id="@+id/w10_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#A9A497" android:textSize="12sp" android:text=""/>
    </LinearLayout>
    <LinearLayout android:id="@+id/w10_r0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/w10_c0" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/widget_ck" android:textColor="#FDDB00" android:textSize="16sp" android:textStyle="bold" android:text="✓"/>
        <TextView android:id="@+id/w10_t0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#F3F0E6" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:text=""/>
    </LinearLayout>
    <LinearLayout android:id="@+id/w10_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/w10_c1" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/widget_ck" android:textColor="#FDDB00" android:textSize="16sp" android:textStyle="bold" android:text="✓"/>
        <TextView android:id="@+id/w10_t1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#F3F0E6" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:text=""/>
    </LinearLayout>
    <LinearLayout android:id="@+id/w10_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/w10_c2" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/widget_ck" android:textColor="#FDDB00" android:textSize="16sp" android:textStyle="bold" android:text="✓"/>
        <TextView android:id="@+id/w10_t2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#F3F0E6" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:text=""/>
    </LinearLayout>
    <LinearLayout android:id="@+id/w10_r3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp" android:visibility="gone">
        <TextView android:id="@+id/w10_c3" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:background="@drawable/widget_ck" android:textColor="#FDDB00" android:textSize="16sp" android:textStyle="bold" android:text="✓"/>
        <TextView android:id="@+id/w10_t3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#F3F0E6" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:text=""/>
    </LinearLayout>
    <TextView android:id="@+id/w10_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#A9A497" android:textSize="13sp" android:text=""/>
</LinearLayout>

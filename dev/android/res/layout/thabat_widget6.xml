<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w6_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg" android:gravity="center">
    <TextView android:id="@+id/w6_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F3F0E6" android:textSize="15sp" android:gravity="center" android:maxLines="1" android:text=""/>
    <TextView android:id="@+id/w6_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#EB6834" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:text=""/>
    <ProgressBar android:id="@+id/w6_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:max="1" android:progress="0"/>
    <TextView android:id="@+id/w6_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:background="@drawable/widget_btn" android:textColor="#111111" android:textSize="14sp" android:textStyle="bold" android:text="+1"/>
</LinearLayout>

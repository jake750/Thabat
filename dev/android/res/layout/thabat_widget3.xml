<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w3_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_bg" android:gravity="center">
    <TextView android:id="@+id/w3_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#D0D4DA" android:textSize="14sp" android:maxLines="2" android:gravity="center" android:text="@string/w3_name"/>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w3_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FDDB00" android:textSize="34sp" android:textStyle="bold" android:text="0"/>
        <TextView android:id="@+id/w3_goal" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:textColor="#9AA0AA" android:textSize="13sp" android:text=""/>
    </LinearLayout>
    <TextView android:id="@+id/w3_next" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="2dp" android:paddingBottom="2dp"
        android:textColor="#9AA0AA" android:textSize="11sp" android:text=""/>
</LinearLayout>

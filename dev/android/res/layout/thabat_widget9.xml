<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w9_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg" android:gravity="center_vertical">
    <TextView android:id="@+id/w9_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#F3F0E6" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text=""/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp">
        <TextView android:id="@+id/w9_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F5C400" android:textSize="34sp" android:textStyle="bold" android:maxLines="1" android:text=""/>
        <TextView android:id="@+id/w9_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginBottom="6dp" android:textColor="#A9A497" android:textSize="13sp" android:maxLines="1" android:text=""/>
    </LinearLayout>
    <TextView android:id="@+id/w9_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A9A497" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:text=""/>
    <TextView android:id="@+id/w9_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#A9A497" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:text=""/>
</LinearLayout>

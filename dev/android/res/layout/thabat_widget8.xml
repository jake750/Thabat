<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w8_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="12dp" android:background="@drawable/widget_bg" android:gravity="center_vertical">
    <ImageView android:id="@+id/w8_cover" android:layout_width="52dp" android:layout_height="72dp" android:layout_marginEnd="10dp" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@string/w8_name"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/w8_lbl" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EB6834" android:textSize="12sp" android:maxLines="1" android:text=""/>
        <TextView android:id="@+id/w8_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#F3F0E6" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:text=""/>
        <TextView android:id="@+id/w8_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#A9A497" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text=""/>
        <ProgressBar android:id="@+id/w8_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progress="0"/>
    </LinearLayout>
</LinearLayout>
